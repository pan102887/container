{
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "get gtest build permission",
            "type": "shell",
            "command": "chmod 755 ./test/gtest_build.sh"
        },
        {
            "label": "gtest build",
            "type": "shell",
            "command": "./test/gtest_build.sh",
            "dependsOn":[
                "get gtest build permission"
            ],
            "dependsOrder": "sequence"
        },

        {
            "label": "get test build permission",
            "type": "shell",
            "command": "chmod 755 ./test/test_build.sh"
        },
        {
            "label": "test build",
            "type": "shell",
            "command": "./test/test_build.sh",
            
            "dependsOn":[
                "gtest build", "get test build permission"
            ],
            "dependsOrder": "parallel"
        }

    ],
    "version": "2.0.0"
}